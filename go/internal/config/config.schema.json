{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "runtime": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "host"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "container"
            },
            "binary": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "pattern": "^[1-9]\\d*[bkmg]?$"
            },
            "cpus": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "binary",
            "memory",
            "cpus"
          ],
          "additionalProperties": false
        }
      ]
    },
    "caps": {
      "type": "object",
      "properties": {
        "ships": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "running": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "ships",
        "running"
      ],
      "additionalProperties": false
    },
    "repositories": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 100,
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "checkouts": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            }
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    "folders": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 100,
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    "harnesses": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "options": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "values": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "maxLength": 100,
                    "pattern": "^[a-z0-9][a-z0-9._-]*$"
                  },
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "default": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                }
              },
              "required": [
                "values"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "flags",
          "options"
        ],
        "additionalProperties": false
      }
    },
    "shipsRoot": {
      "type": "string",
      "minLength": 1
    },
    "prices": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "input": {
            "type": "number",
            "minimum": 0
          },
          "output": {
            "type": "number",
            "minimum": 0
          },
          "cacheRead": {
            "type": "number",
            "minimum": 0
          },
          "cacheWrite": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "input",
          "output",
          "cacheRead",
          "cacheWrite"
        ],
        "additionalProperties": false
      }
    },
    "logins": {
      "type": "object",
      "properties": {
        "default": {
          "type": "object",
          "properties": {
            "claude-code": {
              "type": "string",
              "enum": [
                "apiKey",
                "subscription"
              ]
            },
            "codex": {
              "type": "string",
              "enum": [
                "apiKey",
                "subscription"
              ]
            }
          },
          "additionalProperties": false
        },
        "ships": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "apiKey",
              "subscription"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "caps",
    "repositories",
    "folders",
    "harnesses"
  ],
  "additionalProperties": false
}
