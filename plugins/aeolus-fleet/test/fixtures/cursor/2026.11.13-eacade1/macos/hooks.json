{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 <WORKSPACE>/.cursor/probe.py sessionStart"
      }
    ],
    "preToolUse": [
      {
        "command": "python3 <WORKSPACE>/.cursor/probe.py preToolUse"
      }
    ],
    "postToolUse": [
      {
        "command": "python3 <WORKSPACE>/.cursor/probe.py postToolUse"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "python3 <WORKSPACE>/.cursor/probe.py postToolUseFailure"
      }
    ],
    "stop": [
      {
        "command": "python3 <WORKSPACE>/.cursor/probe.py stop"
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 <WORKSPACE>/.cursor/probe.py sessionEnd"
      }
    ]
  }
}
