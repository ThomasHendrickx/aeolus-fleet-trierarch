{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/aeolus-session-start.sh\"" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__aeolus__send$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${PLUGIN_ROOT:-}\" ] || python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/aeolus-codex-send-model.py\"",
            "commandWindows": "if not defined PLUGIN_ROOT exit /b 0 & py -3 \"%CLAUDE_PLUGIN_ROOT%\\scripts\\aeolus-codex-send-model.py\""
          }
        ]
      }
    ]
  }
}
