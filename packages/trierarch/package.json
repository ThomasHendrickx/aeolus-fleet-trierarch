{
  "name": "@aeolus-fleet/trierarch",
  "version": "0.0.0",
  "description": "Keeps Claude Code and Codex sessions running on your machine for an Aeolus fleet: start, restart, wake.",
  "keywords": [
    "claude-code",
    "codex",
    "git-worktree",
    "ai-agents"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThomasHendrickx/aeolus-fleet-trierarch.git",
    "directory": "packages/trierarch"
  },
  "bugs": {
    "url": "https://github.com/ThomasHendrickx/aeolus-fleet/issues"
  },
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "@aeolus-fleet/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "aeolus-trierarch": "dist/bin/aeolus-trierarch.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json",
    "prepack": "cp ../../LICENSE LICENSE",
    "postpack": "rm LICENSE"
  },
  "dependencies": {
    "@aeolus-fleet/common": "^0.34.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aeolus-fleet/core": "^0.34.0"
  }
}
