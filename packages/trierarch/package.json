{
  "name": "@aeolus-fleet/trierarch",
  "version": "0.0.0",
  "description": "Kept for existing machines only: `aeolus-trierarch upgrade` moves a machine to the aeolus-trierarch binary, and a new machine installs the binary with install.sh. Keeps Claude Code and Codex sessions running for an Aeolus fleet.",
  "keywords": [
    "claude-code",
    "codex",
    "git-worktree",
    "ai-agents"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThomasHendrickx/aeolus-fleet-trierarch.git",
    "directory": "packages/trierarch"
  },
  "bugs": {
    "url": "https://github.com/ThomasHendrickx/aeolus-fleet/issues"
  },
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "@aeolus-fleet/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "aeolus-trierarch": "dist/bin/aeolus-trierarch.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json",
    "prepack": "cp ../../LICENSE LICENSE",
    "postpack": "rm LICENSE"
  },
  "dependencies": {
    "@aeolus-fleet/common": "^0.35.0",
    "@sigstore/bundle": "^5.0.0",
    "@sigstore/protobuf-specs": "^0.5.2",
    "@sigstore/tuf": "^5.0.0",
    "@sigstore/verify": "^4.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aeolus-fleet/core": "^0.35.0"
  }
}
