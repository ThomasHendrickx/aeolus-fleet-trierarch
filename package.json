{
  "name": "aeolus-fleet-trierarch",
  "private": true,
  "description": "Aeolus trierarch binary, aeolus-fleet plugin and session image.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "cd go && go build -o ../aeolus-trierarch ./cmd/aeolus-trierarch",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:unit": "vitest run --project '*:unit'",
    "test:integration": "vitest run --project plugin:integration",
    "test:e2e": "vitest run --project '*:e2e'",
    "test:contract:go": "vitest run --project contract:integration",
    "set-version": "node scripts/set-version.ts"
  },
  "devDependencies": {
    "@aeolus-fleet/common": "^0.48.0",
    "@aeolus-fleet/core": "^0.48.0",
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.11.0",
    "eslint-plugin-check-file": "^3.3.2",
    "testcontainers": "^12.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.1",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@scalar/json-magic": {
      "undici": "7.30.0"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.5"
    }
  }
}
